    async function submitAddStudent() {
      const roll_no = document.getElementById('manualRoll').value;
      const student_name = document.getElementById('manualName').value;
      const subject = document.getElementById('manualSubject') ? document.getElementById('manualSubject').value : 'Statistical Machine Learning';
      const g1 = parseFloat(document.getElementById('manualG1').value);
