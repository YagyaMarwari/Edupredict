  // ── Global Search Filter across tabs and models ────────────────────────
  function filterTacticalSearch(query) {
    if (!query) return;
    const q = query.toLowerCase();

    // If on viva tab, filter viva
    const vivaSearch = document.getElementById('vivaSearchInput');
    if (vivaSearch) {
      vivaSearch.value = query;
      filterVivaQuestions();
    }

    // If on roster, filter roster
    const rosterSearch = document.getElementById('rosterSearchInput');
    if (rosterSearch) {
      rosterSearch.value = query;
      filterRosterTable();
    }
  }

  // ── Ripple Effect on Click for all .nm-button elements ────────────────
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.nm-button');
    if (!btn) return;
    const rect = btn.getBoundingClientRect();
    const circle = document.createElement('span');
    const diameter = Math.max(rect.width, rect.height);
    const radius = diameter / 2;

    circle.style.width = circle.style.height = `${diameter}px`;
    circle.style.left = `${e.clientX - rect.left - radius}px`;
    circle.style.top = `${e.clientY - rect.top - radius}px`;
    circle.classList.add('nm-ripple-circle');

    const ripple = btn.querySelector('.nm-ripple-circle');
    if (ripple) ripple.remove();

    btn.appendChild(circle);
    setTimeout(() => circle.remove(), 600);
  });


  // ── Tab Switcher Override with Neumorphic State & Smooth Scroll ───────
  const __origSwitchTab = switchTab;
  switchTab = function(tabId) {
    document.querySelectorAll('.tab-content').forEach(el => {
      el.classList.add('hidden');
      el.classList.remove('block');
    });
    document.querySelectorAll('.tab-btn').forEach(el => {
      el.classList.remove('nav-link-active', 'nm-inset');
      el.classList.add('nm-flat');
    });

    const target = document.getElementById('tab-' + tabId);
    if (target) {
      target.classList.remove('hidden');
      target.classList.add('block');
    }
    const nav = document.getElementById('nav-' + tabId);
    if (nav) {
      nav.classList.add('nav-link-active', 'nm-inset');
      nav.classList.remove('nm-flat');
    }

    if (tabId === 'models' && typeof initCharts === 'function') {
      initCharts();
    }
    if (tabId === 'predictor' && typeof initPredictorRoster === 'function') {
      initPredictorRoster();
    }
    if (tabId === 'viva' && typeof triggerMathRender === 'function') {
      setTimeout(() => triggerMathRender(), 50);
    }
  };

  // Auto-activate Predictor on load
  document.addEventListener('DOMContentLoaded', function() {
    switchTab('predictor');
    if (typeof applyTeacherSession === 'function' && teacherToken) {
      applyTeacherSession();
    }
  });

  // Intercept triggerPrediction to log into live terminal
  const __origTriggerPrediction = triggerPrediction;
  triggerPrediction = async function() {
    await __origTriggerPrediction();
    const mType = document.getElementById('model_type') ? document.getElementById('model_type').value : 'normal';
    const predScore = document.getElementById('predictedScore') ? document.getElementById('predictedScore').innerText : '11.8';
    const pct = document.getElementById('percentScore') ? document.getElementById('percentScore').innerText : '59.0%';
    logTacticalNode("POST /api/predict", `Inference executed [${mType.toUpperCase()}]: Final G3 = ${predScore}/20 (${pct})`);
  };

  </script>
