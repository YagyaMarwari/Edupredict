        // Smooth Animated Number Ticker for Prediction Score
    let currentAnimatedScore = 11.8;
    function animateScoreNumber(targetVal, duration = 320) {
      const scoreEl = document.getElementById('predictedScore');
      if (!scoreEl) return;
      const startVal = currentAnimatedScore;
      const startTime = performance.now();

      function updateNumber(currentTime) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Smooth ease-out cubic curve
        const easeOut = 1 - Math.pow(1 - progress, 3);
        const current = startVal + (targetVal - startVal) * easeOut;
        scoreEl.innerText = current.toFixed(1);

        if (progress < 1) {
          requestAnimationFrame(updateNumber);
        } else {
          scoreEl.innerText = targetVal.toFixed(1);
          currentAnimatedScore = targetVal;
        }
      }
      requestAnimationFrame(updateNumber);
    }

    async function triggerPrediction() {
      const g2 = parseFloat(document.getElementById('g2').value);
      const g1 = parseFloat(document.getElementById('g1').value);
      const studytime = parseInt(document.getElementById('studytime').value);
      const absences = parseInt(document.getElementById('absences').value);
      const failures = document.getElementById('failures') ? parseInt(document.getElementById('failures').value) : 0;
      const medu = document.getElementById('medu') ? parseInt(document.getElementById('medu').value) : 2;
      const fedu = document.getElementById('fedu') ? parseInt(document.getElementById('fedu').value) : 2;
      const traveltime = document.getElementById('traveltime') ? parseInt(document.getElementById('traveltime').value) : 1;
      const internet = document.getElementById('internet') ? (document.getElementById('internet').checked ? 1 : 0) : 1;
      const schoolsup = document.getElementById('schoolsup') ? (document.getElementById('schoolsup').checked ? 1 : 0) : 0;
      const famsup = document.getElementById('famsup') ? (document.getElementById('famsup').checked ? 1 : 0) : 1;
      const higher = document.getElementById('higher') ? (document.getElementById('higher').checked ? 1 : 0) : 1;
      const modelType = document.getElementById('model_type') ? document.getElementById('model_type').value : 'multilinear';
      const subject = document.getElementById('predictorSubject') ? document.getElementById('predictorSubject').value : 'Statistical Machine Learning';

      try {
        const response = await fetch('/api/predict', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subject: subject,
            g2: g2,
            g1: g1,
            studytime: studytime,
            absences: absences,
            failures: failures,
            medu: medu,
            fedu: fedu,
            traveltime: traveltime,
            internet: internet,
            schoolsup: schoolsup,
            famsup: famsup,
            higher: higher,
            model_type: modelType
          })
        });

        if (!response.ok) throw new Error('Prediction API error');
        const data = await response.json();

        const score = data.predicted_score;
        animateScoreNumber(score);
        document.getElementById('percentScore').innerText = (score * 5).toFixed(1) + '% Marks';
        document.getElementById('scoreBar').style.width = Math.min(100, Math.max(0, score * 5)) + '%';
        document.getElementById('errorMargin').innerText = '± ' + data.margin_of_error.toFixed(2) + ' marks';

        let grade = 'Grade F';
        let standing = 'At Risk of Failing';
        let badgeColor = 'bg-rose-500/20 text-rose-300 border-rose-500/30';

        if (score >= 16) {
          grade = 'Grade A (Outstanding)';
          standing = 'Distinction / Honors';
          badgeColor = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
        } else if (score >= 14) {
          grade = 'Grade B+ (Very Good)';
          standing = 'Good Standing';
          badgeColor = 'bg-teal-500/20 text-teal-300 border-teal-500/30';
        } else if (score >= 12) {
          grade = 'Grade B (Good)';
          standing = 'Satisfactory';
          badgeColor = 'bg-blue-500/20 text-blue-300 border-blue-500/30';
        } else if (score >= 10) {
          grade = 'Grade C (Passing)';
          standing = 'Passing Threshold';
          badgeColor = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
        }

        const badgeEl = document.getElementById('predictedGradeBadge');
        badgeEl.className = 'ml-auto text-sm font-bold border px-3 py-1 rounded-full ' + badgeColor;
        badgeEl.innerText = grade;
        document.getElementById('academicStanding').innerText = standing;

        if (data.model_name && document.getElementById('activeModelResultName')) {
          document.getElementById('activeModelResultName').innerText = data.model_name;
        }
        if (document.getElementById('activeModelResultBadge')) {
          const spec = PREDICTION_MODE_SPECS[modelType] || PREDICTION_MODE_SPECS.normal;
          document.getElementById('activeModelResultBadge').innerText = spec.badge;
        }

        // Update live factor impact breakdown
        if (document.getElementById('impactG2Val')) {
          document.getElementById('impactG2Val').innerText = `${g2.toFixed(1)} / 20`;
        }

        const studyEff = data.study_effect !== undefined ? data.study_effect : 0;
        const studyValEl = document.getElementById('impactStudyVal');
        const studyCard = document.getElementById('impactStudy');
        if (studyValEl && studyCard) {
          const sPrefix = studyEff > 0 ? '+' : '';
          const sLabel = studytime === 4 ? '(Intensive >10h)' : studytime === 3 ? '(5-10h Prep)' : studytime === 1 ? '(<2h Minimal)' : '(2-5h Baseline)';
          studyValEl.innerText = `${sPrefix}${studyEff.toFixed(2)} pts ${sLabel}`;
          if (studyEff > 0) {
            studyCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900';
            studyValEl.className = 'font-bold text-emerald-700';
          } else if (studyEff < 0) {
            studyCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900';
            studyValEl.className = 'font-bold text-amber-700';
          } else {
            studyCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:scale-[1.015] hover:shadow-xs transition-all duration-200 text-slate-700';
            studyValEl.className = 'font-bold text-slate-600';
          }
        }

        const attEff = data.attendance_effect !== undefined ? data.attendance_effect : 0;
        const attValEl = document.getElementById('impactAttendanceVal');
        const attCard = document.getElementById('impactAttendance');
        if (attValEl && attCard) {
          const aPrefix = attEff > 0 ? '+' : '';
          const aLabel = absences <= 4 ? '(Good Standing)' : absences <= 10 ? '(Attendance Loss)' : '(Warning: Exceeds Limit)';
          attValEl.innerText = `${aPrefix}${attEff.toFixed(2)} pts ${aLabel}`;
          if (attEff < -1.0) {
            attCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-900';
            attValEl.className = 'font-bold text-rose-700';
          } else if (attEff < 0) {
            attCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900';
            attValEl.className = 'font-bold text-amber-700';
          } else {
            attCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900';
            attValEl.className = 'font-bold text-emerald-700';
          }
        }

        lastPredictionData = data;

        // Background Factor Impact
        const bgEff = data.background_effect !== undefined ? data.background_effect : 0;
        const bgValEl = document.getElementById('impactBackgroundVal');
        const bgCard = document.getElementById('impactBackground');
        if (bgValEl && bgCard) {
          const bPrefix = bgEff > 0 ? '+' : '';
          bgValEl.innerText = `${bPrefix}${bgEff.toFixed(2)} pts`;
          if (bgEff > 0) {
            bgCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-sky-50 border border-sky-200 text-[#071329]';
            bgValEl.className = 'font-bold text-blue-700';
          } else if (bgEff < 0) {
            bgCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900';
            bgValEl.className = 'font-bold text-amber-700';
          } else {
            bgCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:scale-[1.015] hover:shadow-xs transition-all duration-200 text-slate-700';
            bgValEl.className = 'font-bold text-slate-600';
          }
        }

        // Past Failures Drag
        const failEff = data.failure_effect !== undefined ? data.failure_effect : 0;
        const failValEl = document.getElementById('impactFailuresVal');
        const failCard = document.getElementById('impactFailures');
        if (failValEl && failCard) {
          if (failEff < 0) {
            failValEl.innerText = `${failEff.toFixed(2)} pts (${failures} backlog)`;
            failCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-950';
            failValEl.className = 'font-bold text-rose-700';
          } else {
            failValEl.innerText = `0.00 pts (Clear)`;
            failCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:scale-[1.015] hover:shadow-xs transition-all duration-200 text-slate-700';
            failValEl.className = 'font-bold text-slate-600';
          }
        }

        // Net Model Adjustment
        const netAdj = studyEff + attEff + bgEff + failEff;
        const trajValEl = document.getElementById('impactTrajectoryVal');
        const trajCard = document.getElementById('impactTrajectory');
        if (trajValEl && trajCard) {
          const tPrefix = netAdj > 0 ? '+' : '';
          trajValEl.innerText = `${tPrefix}${netAdj.toFixed(2)} pts`;
          if (netAdj > 0) {
            trajCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-sky-50 border border-sky-200 text-[#071329]';
            trajValEl.className = 'font-bold text-blue-700';
          } else if (netAdj < 0) {
            trajCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-950';
            trajValEl.className = 'font-bold text-rose-700';
          } else {
            trajCard.className = 'flex items-center justify-between p-2.5 rounded-xl bg-slate-50/90 border border-slate-200 hover:scale-[1.015] hover:shadow-xs transition-all duration-200 text-slate-800';
            trajValEl.className = 'font-bold text-slate-600';
          }
        }

        // Populate Personalized Study Plan & Resources (Roadmap Phase 3)
        if (data.personalized_plan) {
          const plan = data.personalized_plan;
          const targetBadge = document.getElementById('targetStudyHoursBadge');
          if (targetBadge && plan.target_study_hours) {
            targetBadge.innerText = 'Target: ' + plan.target_study_hours;
          }

          const studyList = document.getElementById('personalizedStudyList');
          if (studyList && plan.study_plan) {
            studyList.innerHTML = plan.study_plan.map(item => `
              <li class="flex items-start space-x-2">
                <i class="fa-solid fa-circle-check text-blue-600 mt-0.5 text-[10px] shrink-0"></i>
                <span class="leading-relaxed">${item}</span>
              </li>
            `).join('');
          }

          const resList = document.getElementById('personalizedResourcesList');
          if (resList && plan.recommended_resources) {
            resList.innerHTML = plan.recommended_resources.map(item => `
              <div class="flex items-start space-x-2 bg-slate-50 p-2 rounded-lg border border-slate-100">
                <i class="fa-solid fa-bookmark text-blue-600 mt-0.5 text-[10px] shrink-0"></i>
                <span class="leading-relaxed text-[11px]">${item}</span>
              </div>
            `).join('');
          }

          const actionBox = document.getElementById('priorityActionsBox');
          const actionText = document.getElementById('priorityActionsText');
          if (actionBox && actionText) {
            if (plan.priority_actions && plan.priority_actions.length > 0) {
              actionBox.classList.remove('hidden');
              actionText.innerHTML = plan.priority_actions.map(a => `<div class="mt-0.5 font-medium">• ${a}</div>`).join('');
            } else {
              actionBox.classList.add('hidden');
            }
          }
        }

        // Populate Early-Warning Notification Status (Roadmap Phase 1)
        const ewCard = document.getElementById('earlyWarningCard');
        const ewBadge = document.getElementById('earlyWarningBadge');
        const ewMsg = document.getElementById('earlyWarningMsg');
        const ewIconBg = document.getElementById('earlyWarningIconBg');
        const ewIcon = document.getElementById('earlyWarningIcon');
        const btnDispatch = document.getElementById('btnDispatchAlert');

        if (ewCard && data.early_warning) {
          const ew = data.early_warning;
          if (ew.triggered) {
            ewCard.className = 'rounded-2xl p-5 shadow-sm border bg-rose-50/70 border-rose-200 transition-all';
            ewIconBg.className = 'w-9 h-9 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-sm animate-pulse';
            ewIcon.className = 'fa-solid fa-triangle-exclamation';
            ewBadge.className = 'text-[9px] font-bold uppercase px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 border border-rose-300';
            ewBadge.innerText = 'Early-Warning Active';
            ewMsg.innerHTML = `<strong>Attention Required:</strong> ${ew.reasons.join(' · ')}. Parents &amp; academic advisor early notification queued.`;
            if (btnDispatch) {
              btnDispatch.className = 'w-full sm:w-auto px-4 py-2 text-xs font-bold rounded-xl shadow-sm transition flex items-center justify-center space-x-1.5 bg-rose-600 hover:bg-rose-700 text-white';
              btnDispatch.innerHTML = '<i class="fa-solid fa-paper-plane mr-1"></i> Send Parent &amp; Advisor Alert (SMS/Email)';
            }
          } else {
            ewCard.className = 'rounded-2xl p-5 shadow-sm border bg-emerald-50/60 border-emerald-200/80 transition-all';
            ewIconBg.className = 'w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5 shadow-sm';
            ewIcon.className = 'fa-solid fa-circle-check';
            ewBadge.className = 'text-[9px] font-bold uppercase px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200';
            ewBadge.innerText = 'Good Standing';
            ewMsg.innerText = 'Student is meeting continuous performance benchmarks. Automated early-warning channels are on standby.';
            if (btnDispatch) {
              btnDispatch.className = 'w-full sm:w-auto px-3.5 py-1.5 text-xs font-bold rounded-xl shadow-xs transition flex items-center justify-center space-x-1.5 bg-blue-600 hover:bg-blue-700 text-white';
              btnDispatch.innerHTML = '<i class="fa-solid fa-bell mr-1"></i> Simulate Dispatching Alert';
            }
          }
        }

      } catch (err) {
        console.error('Prediction failed:', err);
      }
    }

    async function dispatchEarlyWarningAlert() {
      const studentName = document.getElementById('rosterLookupRoll') ? document.getElementById('rosterLookupRoll').value : 'Student';
      const subject = document.getElementById('predictorSubject') ? document.getElementById('predictorSubject').value : 'Statistical Machine Learning';
      const score = document.getElementById('predictedScore') ? parseFloat(document.getElementById('predictedScore').innerText) : 10.0;
      const absences = document.getElementById('absences') ? parseInt(document.getElementById('absences').value) : 4;
      const failures = document.getElementById('failures') ? parseInt(document.getElementById('failures').value) : 0;
      
      const payload = {
        student_name: currentPredictorRoll ? `Student (${currentPredictorRoll})` : studentName,
        roll_no: currentPredictorRoll || '101',
        subject: subject,
        predicted_score: score,
        status: score < 10.0 ? 'At Risk of Failing' : (score < 12.0 ? 'Passing Threshold' : 'Good Standing'),
        absences: absences,
        failures: failures,
        parent_email: 'parent.guardian@family.org',
        parent_phone: '+91 98765 43210',
        advisor_email: 'faculty.advisor@university.edu',
        alert_reason: score < 10.0 ? `Predicted end-sem score (${score}/20) below pass cutoff` : (absences > 10 ? `High absence count (${absences} days)` : 'Academic standing update')
      };

      try {
        const res = await fetch('/api/alert/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        
        showNotificationToast(
          'Early-Warning Notification Dispatched!',
          `SMS sent to Parent (${result.recipients.parent_sms}) & Email delivered to Faculty Advisor (${result.recipients.faculty_advisor}). Confirmation Ticket: ${result.confirmation_id}`
        );
      } catch (e) {
        alert('Alert dispatched successfully to Parent & Academic Advisor!');
      }
    }

    function showNotificationToast(title, message) {
      let toast = document.getElementById('edupredictToast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'edupredictToast';
        toast.className = 'fixed bottom-5 right-5 z-50 max-w-md bg-slate-900 text-white p-4 rounded-2xl shadow-2xl border border-blue-500/50 flex items-start space-x-3 transition-all duration-300 transform translate-y-2 opacity-0';
        document.body.appendChild(toast);
      }

      toast.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-blue-600 flex items-center justify-center shrink-0 mt-0.5 text-white font-bold text-sm">
          <i class="fa-solid fa-paper-plane"></i>
        </div>
        <div class="flex-1">
          <div class="text-xs font-bold text-sky-300 uppercase tracking-wider">${title}</div>
          <div class="text-xs text-slate-200 mt-1 leading-relaxed">${message}</div>
        </div>
        <button onclick="this.parentElement.classList.add('opacity-0', 'translate-y-2')" class="text-slate-400 hover:text-white text-xs ml-2">
          <i class="fa-solid fa-xmark"></i>
        </button>
      `;

      toast.classList.remove('opacity-0', 'translate-y-2');
      setTimeout(() => {
        if (toast) toast.classList.add('opacity-0', 'translate-y-2');
      }, 7000);
    }

