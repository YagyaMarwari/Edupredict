        errBox.textContent = 'Server connection error during login.';
        errBox.classList.remove('hidden');
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-shield-halved"></i><span>Sign In</span>';
        return;
      }
    } else {
      // Role: Student
