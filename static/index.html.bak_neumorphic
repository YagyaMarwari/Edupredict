      } else {
        const mod = sub.modules.find(m => m.id === currentVivaModule) || sub.modules[0];
        document.getElementById('vivaSelectedModuleLabel').innerText = mod.name;
        document.getElementById('vivaBannerBadge').innerText = mod.name;
        document.getElementById('vivaBannerTitle').innerText = mod.title;
        document.getElementById('vivaBannerDesc').innerText = mod.desc;
      }
    }

    function renderVivaQuestions() {
      const container = document.getElementById('vivaQuestionsContainer');
      if (!container) return;
      container.innerHTML = '';

      const sub = VIVA_DATA[currentVivaSubject];
      if (!sub) return;

      const query = (document.getElementById('vivaSearchInput').value || '').toLowerCase().trim();

      let questionList = [];
      if (currentVivaModule === 'all') {
        sub.modules.forEach(m => {
          m.questions.forEach(q => {
            questionList.push({ ...q, moduleName: m.name, moduleTitle: m.title });
          });
        });
      } else {
        const mod = sub.modules.find(m => m.id === currentVivaModule) || sub.modules[0];
        mod.questions.forEach(q => {
          questionList.push({ ...q, moduleName: mod.name, moduleTitle: mod.title });
        });
      }

      if (query) {
        questionList = questionList.filter(q => 
          q.q.toLowerCase().includes(query) || 
          q.a.toLowerCase().includes(query) || 
          q.badge.toLowerCase().includes(query)
        );
      }

      if (questionList.length === 0) {
        container.innerHTML = `
          <div class="bg-white rounded-2xl p-8 text-center border border-slate-200 text-slate-400">
            <i class="fa-solid fa-file-circle-question text-3xl mb-2 text-slate-300"></i>
            <p class="text-xs font-semibold">No questions match your search query.</p>
          </div>
        `;
        return;
      }

      questionList.forEach((q, idx) => {
        const card = document.createElement('div');
        card.className = 'bg-white rounded-2xl p-5 shadow-sm border border-slate-200 transition hover:shadow-md';
        const qId = `vivaAns_${idx}`;

        card.innerHTML = `
          <div class="flex items-start justify-between gap-3 mb-2">
            <div class="flex items-center space-x-2.5">
              <span class="w-6 h-6 rounded-full bg-sky-100 text-blue-700 flex items-center justify-center text-xs font-bold shrink-0">
                ${idx + 1}
              </span>
              <span class="text-xs font-bold text-slate-900 leading-snug">
                ${q.q}
              </span>
            </div>
            <div class="flex items-center space-x-1.5 shrink-0">
              <span class="text-[10px] font-semibold bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">
                ${q.moduleName}
              </span>
              <span class="text-[10px] font-bold bg-sky-50 text-blue-700 px-2 py-0.5 rounded-full border border-sky-200">
                ${q.badge}
              </span>
            </div>
          </div>

          <div id="${qId}" class="mt-3 pl-8 pt-3 border-t border-slate-100 text-xs text-slate-600 leading-relaxed ${
            vivaPracticeMode ? 'hidden' : ''
          }">
            <div class="bg-slate-50/80 rounded-xl p-3.5 border border-slate-200/60">
              <span class="font-bold text-slate-800 block mb-1 flex items-center space-x-1.5">
                <i class="fa-solid fa-graduation-cap text-blue-600"></i>
                <span>Model Faculty Answer:</span>
              </span>
              ${q.a}
            </div>
          </div>

          <div class="pl-8 mt-2 flex items-center justify-between text-[11px]">
            <button type="button" onclick="toggleSingleAnswer('${qId}')" class="text-blue-600 hover:text-blue-900 font-bold flex items-center space-x-1">
              <i class="fa-solid fa-eye text-xs"></i>
              <span id="btn_${qId}">${vivaPracticeMode ? 'Show Answer' : 'Hide Answer'}</span>
            </button>
            <span class="text-slate-400 text-[10px]">Academic Exam Ready</span>
          </div>
        `;
        container.appendChild(card);
      });

      // Render KaTeX mathematical expressions
      triggerMathRender(container);
    }

    function triggerMathRender(targetElement) {
      const target = targetElement || document.getElementById('vivaQuestionsContainer');
      if (!target) return;

      if (window.renderMathInElement) {
        try {
          renderMathInElement(target, {
            delimiters: [
              {left: '$$', right: '$$', display: true},
              {left: '$', right: '$', display: false},
              {left: '\\(', right: '\\)', display: false},
              {left: '\\[', right: '\\]', display: true}
            ],
            throwOnError: false,
            errorColor: '#e11d48',
            ignoredTags: ["script", "noscript", "style", "textarea", "pre", "code"]
          });
        } catch (err) {
          console.warn('KaTeX auto-render warning:', err);
        }
      } else {
        // If KaTeX is still asynchronously loading, retry after a short delay
        setTimeout(() => {
          if (window.renderMathInElement) {
            triggerMathRender(target);
          }
        }, 150);
      }
    }

    function filterVivaQuestions() {
      renderVivaQuestions();
    }

    function toggleSingleAnswer(qId) {
      const ansEl = document.getElementById(qId);
      const btnEl = document.getElementById('btn_' + qId);
      if (!ansEl) return;
      ansEl.classList.toggle('hidden');
      if (btnEl) {
        btnEl.innerText = ansEl.classList.contains('hidden') ? 'Show Answer' : 'Hide Answer';
      }
      if (!ansEl.classList.contains('hidden')) {
        triggerMathRender(ansEl);
      }
    }

    function toggleVivaPracticeMode() {
      vivaPracticeMode = !vivaPracticeMode;
      const btnText = document.getElementById('vivaPracticeText');
      const btnIcon = document.getElementById('vivaPracticeIcon');

      if (vivaPracticeMode) {
        btnText.innerText = 'Exit Practice: Show All Answers';
        btnIcon.className = 'fa-solid fa-eye';
      } else {
        btnText.innerText = 'Practice Mode: Hide Answers';
        btnIcon.className = 'fa-solid fa-eye-slash';
      }
      renderVivaQuestions();
    }


    window.addEventListener('DOMContentLoaded', () => {
      initAuthUI();
      initPredictorRoster();
      initVivaGuide();
      if (teacherToken) {
        loadDemoClassData();
      } else {
        // No session — switch to predictor tab and show login modal
        switchTab('predictor');
        setTimeout(openLoginModal, 300);
      }
    });

    window.addEventListener('load', () => {
      triggerMathRender();
    });
