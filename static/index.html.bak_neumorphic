    // Render roster data & KPIs
    let classChartInstance = null;
    function renderRosterData(data) {
      currentRoster = data.students || [];
      const summary = data.summary;

      // KPIs
      document.getElementById('kpiTotal').innerText = summary.total_students;
      document.getElementById('kpiAvg').innerText = summary.class_average.toFixed(1);
      document.getElementById('kpiRisk').innerText = summary.at_risk_count;
      document.getElementById('kpiDistinction').innerText = summary.distinction_count;
      document.getElementById('kpiPassRate').innerText = 'Pass Rate: ' + summary.pass_rate + '%';

      // Render chart
