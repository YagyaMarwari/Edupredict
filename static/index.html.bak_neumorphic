  <style>
    /* ==========================================================================
       TACTICAL NEUMORPHIC DESIGN SYSTEM (SOFT UI + ATHLETIC-INDUSTRIAL FUSION)
       ========================================================================== */
    :root {
      /* LIGHT MODE: Strict Neumorphic Soft UI */
      --nm-bg: #e0e5ec;
      --nm-surface: #e0e5ec;
      --nm-surface-accent: #eef2f7;
      --nm-highlight: #ffffff;
      --nm-shadow: #a3b1c6;
      --nm-text: #1e293b;
      --nm-text-muted: #64748b;

      /* Athletic-Industrial Palette */
      --color-ready: #16a34a;
      --color-ready-soft: rgba(22, 163, 74, 0.12);
      --color-waiting: #d97706;
      --color-waiting-soft: rgba(217, 119, 6, 0.12);
      --color-blocked: #dc2626;
      --color-blocked-soft: rgba(220, 38, 38, 0.12);
      --color-info: #0284c7;
      --color-info-soft: rgba(2, 132, 199, 0.12);
      --color-indigo: #6366f1;
      --color-indigo-soft: rgba(99, 102, 241, 0.12);
      --color-rose: #f43f5e;
      --color-rose-soft: rgba(244, 63, 94, 0.12);

      /* Neumorphic Shadows (Top-left Highlight, Bottom-right Shadow) */
      --nm-flat: 6px 6px 14px var(--nm-shadow), -6px -6px 14px var(--nm-highlight);
      --nm-flat-hover: 8px 8px 18px var(--nm-shadow), -8px -8px 18px var(--nm-highlight);
      --nm-inset: inset 4px 4px 8px var(--nm-shadow), inset -4px -4px 8px var(--nm-highlight);
      --nm-inset-deep: inset 6px 6px 12px var(--nm-shadow), inset -6px -6px 12px var(--nm-highlight);

      --pitch-line: rgba(148, 163, 184, 0.45);
      --pitch-bg: #d5dbe5;
      --device-frame: #d0d7e2;
      --terminal-bg: #dbe2ec;
      --terminal-text: #0369a1;
      --card-bg: #e0e5ec;
      --input-bg: #e0e5ec;
    }

    html.dark {
      /* DARK MODE: Tactical Deep Navy #0f172a, Rail Slate #090d16 & Neumorphic #1e2030 */
      --nm-bg: #0f172a;
      --nm-surface: #0f172a;
      --nm-surface-accent: #090d16;
      --nm-highlight: #2a2d42;      /* Explicit spec highlight */
      --nm-shadow: #050810;         /* Explicit spec shadow */
      --nm-text: #f1f5f9;
      --nm-text-muted: #94a3b8;

      --color-ready: #16a34a;
      --color-ready-soft: rgba(22, 163, 74, 0.18);
      --color-waiting: #d97706;
      --color-waiting-soft: rgba(217, 119, 6, 0.18);
      --color-blocked: #dc2626;
      --color-blocked-soft: rgba(220, 38, 38, 0.18);
      --color-info: #0284c7;
      --color-info-soft: rgba(2, 132, 199, 0.18);
      --color-indigo: #6366f1;
      --color-indigo-soft: rgba(99, 102, 241, 0.18);
      --color-rose: #f43f5e;
      --color-rose-soft: rgba(244, 63, 94, 0.18);

      --nm-flat: 6px 6px 14px var(--nm-shadow), -6px -6px 14px var(--nm-highlight);
      --nm-flat-hover: 8px 8px 20px var(--nm-shadow), -8px -8px 20px var(--nm-highlight);
      --nm-inset: inset 4px 4px 8px var(--nm-shadow), inset -4px -4px 8px var(--nm-highlight);
      --nm-inset-deep: inset 6px 6px 12px var(--nm-shadow), inset -6px -6px 12px var(--nm-highlight);

      --pitch-line: #1e293b;
      --pitch-bg: #090d16;
      --device-frame: #090d16;
      --terminal-bg: #090d16;
      --terminal-text: #4ade80;
      --card-bg: #0f172a;
      --input-bg: #0f172a;
    }

    /* Core Typography */
    body {
      font-family: 'Satoshi', 'Inter', sans-serif;
      background-color: var(--nm-bg);
      color: var(--nm-text);
      transition: background-color 0.4s ease, color 0.4s ease;
      overflow-x: hidden;
    }

    h1, h2, h3, .font-heading {
      font-family: 'Archivo', 'General Sans', sans-serif;
      letter-spacing: -0.02em;
    }

    .font-mono-tech {
      font-family: 'DM Mono', monospace;
    }

    /* Neumorphic Convex & Inset Elements */
    .nm-flat {
      background: var(--nm-surface);
      box-shadow: var(--nm-flat);
      border-radius: 16px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .nm-flat-hover:hover {
      transform: scale(1.015);
      box-shadow: var(--nm-flat-hover);
    }

    .nm-inset {
      background: var(--nm-surface);
      box-shadow: var(--nm-inset);
      border-radius: 12px;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .nm-inset-deep {
      background: var(--nm-surface-accent);
      box-shadow: var(--nm-inset-deep);
      border-radius: 14px;
    }

    /* Tactile Neumorphic Buttons */
    .nm-button {
      background: var(--nm-surface);
      box-shadow: var(--nm-flat);
      border-radius: 12px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
      cursor: pointer;
      font-family: 'Archivo', sans-serif;
      font-weight: 700;
      transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .nm-button:hover {
      transform: translateY(-2px);
      box-shadow: var(--nm-flat-hover);
    }
    .nm-button:active {
      transform: translateY(0);
      box-shadow: var(--nm-inset);
    }

    /* Icon 360-degree rotation on hover */
    .hover-spin:hover i, .nm-button:hover i {
      transform: rotate(360deg);
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Click Ripple Effect */
    .nm-ripple-circle {
      position: absolute;
      border-radius: 50%;
      transform: scale(0);
      animation: rippleAnimation 0.6s linear;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.4) 0%, rgba(22, 163, 74, 0.1) 70%, transparent 100%);
      pointer-events: none;
    }
    @keyframes rippleAnimation {
      to {
        transform: scale(4);
        opacity: 0;
      }
    }

    /* Bobbing Float Icon */
    @keyframes floatIcon {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-5px); }
    }
    .float-icon {
      animation: floatIcon 2.8s ease-in-out infinite;
    }

    /* Dynamic Count Pulse */
    @keyframes countPulseAnim {
      0% { transform: scale(1); }
      50% { transform: scale(1.12); }
      100% { transform: scale(1); }
    }
    .count-pulse {
      animation: countPulseAnim 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    /* Status Chip Component (PitchPeople Spec: 24px height, 4px 10px pad, 999px radius, DM Mono 11px uppercase, 7px dot) */
    .status-chip {
      height: 24px;
      padding: 4px 10px;
      border-radius: 999px;
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-weight: 500;
      line-height: 1;
      white-space: nowrap;
    }
    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      display: inline-block;
      flex-shrink: 0;
    }
    .chip-ready {
      background: var(--color-ready-soft);
      color: var(--color-ready);
    }
    .chip-ready .status-dot { background: var(--color-ready); box-shadow: 0 0 6px var(--color-ready); }

    .chip-waiting {
      background: var(--color-waiting-soft);
      color: var(--color-waiting);
    }
    .chip-waiting .status-dot { background: var(--color-waiting); }

    .chip-blocked {
      background: var(--color-blocked-soft);
      color: var(--color-blocked);
    }
    .chip-blocked .status-dot { background: var(--color-blocked); }

    .chip-info {
      background: var(--color-info-soft);
      color: var(--color-info);
    }
    .chip-info .status-dot { background: var(--color-info); }

    .chip-indigo {
      background: var(--color-indigo-soft);
      color: var(--color-indigo);
    }
    .chip-indigo .status-dot { background: var(--color-indigo); }

    /* Animated Flowing Progress Bars */
    .progress-track {
      background: var(--nm-surface);
      box-shadow: var(--nm-inset);
      border-radius: 999px;
      overflow: hidden;
      height: 12px;
      position: relative;
    }
    .progress-fill {
      height: 100%;
      border-radius: 999px;
      background: linear-gradient(90deg, #16a34a, #10b981, #6366f1);
      position: relative;
      overflow: hidden;
      box-shadow: 0 0 10px rgba(22, 163, 74, 0.4);
      transition: width 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .progress-fill::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.45), transparent);
      animation: waveShimmer 2.5s infinite;
    }
    @keyframes waveShimmer {
      0% { transform: translateX(-150%); }
      100% { transform: translateX(250%); }
    }

    /* Terminal Mockup with Monospace & Blinking Cursor */
    .terminal-window {
      background: var(--terminal-bg);
      box-shadow: var(--nm-inset-deep);
      border-radius: 14px;
      font-family: 'DM Mono', monospace;
      color: var(--terminal-text);
    }
    @keyframes cursorBlink {
      0%, 49% { opacity: 1; }
      50%, 100% { opacity: 0; }
    }
    .blinking-cursor {
      animation: cursorBlink 0.9s infinite;
    }

    /* 420px Interactive Orbital Lens Ring */
    .lens-orbit-container {
      width: 420px;
      height: 420px;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
    }
    .lens-orbit-ring {
      position: absolute;
      inset: 15px;
      border: 2px dashed rgba(99, 102, 241, 0.35);
      border-radius: 50%;
      animation: orbitalSpin 24s linear infinite;
    }
    @keyframes orbitalSpin {
      100% { transform: rotate(360deg); }
    }
    @keyframes orbitalCounterSpin {
      100% { transform: rotate(-360deg); }
    }
    .orbital-chip {
      position: absolute;
      transform: translate(-50%, -50%);
      cursor: pointer;
      transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .orbital-chip:hover {
      transform: translate(-50%, -50%) scale(1.12);
    }
    .orbital-chip-inner {
      display: inline-block;
      animation: orbitalCounterSpin 24s linear infinite;
    }

    /* Pitch Tactical Drawing Animation */
    @keyframes drawPitchLine {
      from { stroke-dashoffset: 1200; }
      to { stroke-dashoffset: 0; }
    }
    .pitch-svg-draw path, .pitch-svg-draw line, .pitch-svg-draw circle, .pitch-svg-draw rect {
      stroke-dasharray: 1200;
      stroke-dashoffset: 1200;
      animation: drawPitchLine 2.8s cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
    }

    /* Tactical Formation Pop-in Nodes */
    @keyframes popTacticalNode {
      0% { transform: scale(0.4); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .tactical-node {
      animation: popTacticalNode 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.2s;
    }
    .tactical-node:hover {
      transform: scale(1.22);
      filter: drop-shadow(0 0 10px currentColor);
    }

    /* Reveal On Scroll Animation */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.6s cubic-bezier(0.2, 0.6, 0.3, 1), transform 0.6s cubic-bezier(0.2, 0.6, 0.3, 1);
    }
    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Custom Sliders for Neumorphism */
    input[type=range] {
      -webkit-appearance: none;
      appearance: none;
      width: 100%;
      height: 8px;
      border-radius: 9999px;
      background: var(--nm-surface);
      box-shadow: var(--nm-inset);
      outline: none;
    }
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: linear-gradient(135deg, #16a34a, #6366f1);
      cursor: pointer;
      border: 2.5px solid #ffffff;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.5);
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    input[type=range]::-webkit-slider-thumb:hover {
      transform: scale(1.25);
    }

    /* Tab active highlight */
    .nav-link-active {
      box-shadow: var(--nm-inset) !important;
      color: #16a34a !important;
    }
    html.dark .nav-link-active {
      color: #4ade80 !important;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: var(--nm-bg); }
    ::-webkit-scrollbar-thumb { background: #64748b; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #16a34a; }
  

    /* ── STRICT NEUMORPHIC OVERRIDES FOR ALL CARDS & TABS ── */
    .glow-card, .tab-content .bg-white, .tab-content [class*="bg-slate-50"], .tab-content [class*="bg-sky-50"] {
      background: var(--nm-surface) !important;
      box-shadow: var(--nm-flat) !important;
      border: none !important;
      color: var(--nm-text) !important;
    }

    .hero-dark-glow {
      background: var(--nm-surface-accent) !important;
      box-shadow: var(--nm-flat) !important;
      border: 1px solid rgba(99, 102, 241, 0.2) !important;
    }

    /* Inputs, Selects, and Textareas */
    input[type="text"], input[type="number"], input[type="password"], select, textarea {
      background: var(--nm-surface) !important;
      color: var(--nm-text) !important;
      box-shadow: var(--nm-inset) !important;
      border: none !important;
      border-radius: 12px !important;
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    input[type="text"]:focus, input[type="number"]:focus, input[type="password"]:focus, select:focus, textarea:focus {
      box-shadow: var(--nm-inset-deep), 0 0 0 2px rgba(22, 163, 74, 0.4) !important;
      outline: none !important;
    }

    /* Table Neumorphic Styling */
    table {
      border-collapse: separate !important;
      border-spacing: 0 4px !important;
    }
    thead th {
      background: var(--nm-surface-accent) !important;
      color: var(--nm-text-muted) !important;
      border: none !important;
      font-family: 'DM Mono', monospace !important;
      font-size: 11px !important;
      text-transform: uppercase !important;
      letter-spacing: 0.05em !important;
    }
    tbody tr {
      background: var(--nm-surface) !important;
      box-shadow: var(--nm-flat) !important;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    tbody tr:hover {
      transform: translateY(-1px);
    }
    tbody td {
      border: none !important;
      color: var(--nm-text) !important;
    }

    /* Text Color Adaptation */
    .text-slate-800, .text-slate-900, .text-slate-700 {
      color: var(--nm-text) !important;
    }
    .text-slate-600, .text-slate-500 {
      color: var(--nm-text-muted) !important;
    }
    .border-slate-100, .border-slate-200, .border-slate-300 {
      border-color: rgba(148, 163, 184, 0.15) !important;
    }

    /* Modals Neumorphism */
    #addStudentModal > div, #loginModal > div {
      background: var(--nm-surface) !important;
      box-shadow: var(--nm-flat-hover) !important;
      border: 1px solid rgba(99, 102, 241, 0.3) !important;
      border-radius: 24px !important;
      color: var(--nm-text) !important;
    }

</style>
</head>
