    let studentActiveSubject = null;
    function renderStudentProfile(studentData) {
      document.getElementById('studentLoginPrompt').classList.add('hidden');
      document.getElementById('studentDashboard').classList.remove('hidden');

      window.currentStudentData = studentData;
      const allSubs = studentData.all_subjects || [studentData.profile || studentData];
      const summary = studentData.summary || {
        overall_gpa: (allSubs.reduce((a, b) => a + b.predicted_g3, 0) / (allSubs.length * 2)).toFixed(2),
        avg_predicted_score: (allSubs.reduce((a, b) => a + b.predicted_g3, 0) / allSubs.length).toFixed(1),
        avg_percentage: ((allSubs.reduce((a, b) => a + b.predicted_g3, 0) / allSubs.length) * 5.0).toFixed(1),
        total_subjects: allSubs.length,
        distinction_count: allSubs.filter(s => s.predicted_g3 >= 15).length
      };

      const p0 = allSubs[0];
      let formattedName = p0.student_name || ('Roll #' + p0.roll_no);
      const mName = formattedName.match(/^Student\s*\((.+)\)$/i);
      if (mName) {
        formattedName = `${mName[1].trim()} (Student)`;
      } else if (!formattedName.includes('(Student)')) {
        formattedName = `${formattedName} (Student)`;
      }
      document.getElementById('studentRollBadge').innerText = 'Roll #' + p0.roll_no;
      document.getElementById('studentNameDisplay').innerText = formattedName;
      if (document.getElementById('authLabel')) {
        document.getElementById('authLabel').innerText = formattedName;
      }

      // Update Cumulative Semester KPIs
      document.getElementById('studentOverallGpa').innerText = summary.overall_gpa + ' / 10';
      document.getElementById('studentOverallAvg').innerText = summary.avg_predicted_score + ' / 20';
      document.getElementById('studentOverallPct').innerText = summary.avg_percentage + '% Marks Average';
      document.getElementById('studentDistinctionCount').innerText = summary.distinction_count + ' Subjects';
      document.getElementById('studentTotalSubjects').innerText = summary.total_subjects + ' Subjects';

      // Populate Subject Switcher Pills
      const pillsContainer = document.getElementById('studentSubjectPills');
      pillsContainer.innerHTML = '';
      if (!studentActiveSubject || !allSubs.find(s => s.subject === studentActiveSubject)) {
        studentActiveSubject = allSubs[0].subject;
      }

      allSubs.forEach(sub => {
        const isActive = sub.subject === studentActiveSubject;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 border ${
          isActive 
            ? 'bg-sky-600 text-white border-sky-600 shadow-sm shadow-sky-200' 
            : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200'
        }`;
        btn.innerHTML = `
          <span>${sub.subject}</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded-full font-black ${
            isActive ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-700'
          }">${sub.predicted_g3.toFixed(1)}</span>
        `;
        btn.onclick = () => {
          studentActiveSubject = sub.subject;
          renderStudentProfile(studentData);
        };
        pillsContainer.appendChild(btn);
      });

      // Show details for active subject
      const active = allSubs.find(s => s.subject === studentActiveSubject) || allSubs[0];
      document.getElementById('studentActiveSubjectTag').innerText = active.subject;
      document.getElementById('studentG1').innerText = active.g1 + ' / 20';
      document.getElementById('studentG2').innerText = active.g2 + ' / 20';
      document.getElementById('studentStudy').innerText = active.studytime + ' (' + (active.studytime >= 3 ? '5-10h' : '2-5h') + ')';
      document.getElementById('studentAbsences').innerText = active.absences + ' days';

      document.getElementById('studentPredictedScore').innerText = active.predicted_g3.toFixed(1);
      document.getElementById('studentPercentage').innerText = active.percentage.toFixed(1) + '% Marks';
      document.getElementById('studentScoreBar').style.width = Math.min(100, active.percentage) + '%';

      let gradeBadgeClass = 'bg-slate-100 text-slate-800 border-slate-200';
      let recCardClass = 'bg-slate-50 border-slate-200 text-slate-800';

      if (active.status === 'Distinction') {
        gradeBadgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-300';
        recCardClass = 'bg-emerald-50 border-emerald-200 text-emerald-900';
      } else if (active.status === 'Good Standing') {
        gradeBadgeClass = 'bg-blue-100 text-blue-800 border-blue-300';
        recCardClass = 'bg-blue-50 border-blue-200 text-blue-900';
      } else if (active.status === 'Passing') {
        gradeBadgeClass = 'bg-amber-100 text-amber-800 border-amber-300';
        recCardClass = 'bg-amber-50 border-amber-200 text-amber-900';
      } else if (active.status === 'At Risk') {
        gradeBadgeClass = 'bg-rose-100 text-rose-800 border-rose-300 animate-pulse';
        recCardClass = 'bg-rose-50 border-rose-200 text-rose-900';
      }

      const badgeEl = document.getElementById('studentGradeBadge');
      badgeEl.className = 'text-xs font-bold border px-3 py-1 rounded-full ' + gradeBadgeClass;
      badgeEl.innerText = 'Grade ' + active.letter_grade + ' (' + active.status + ')';

      const recCard = document.getElementById('studentRecCard');
      recCard.className = 'mt-6 p-4 rounded-xl border text-xs ' + recCardClass;
      document.getElementById('studentRecText').innerText = active.recommendation;

      // Populate All Enrolled Subjects Table
      const allTableBody = document.getElementById('studentAllSubjectsTableBody');
      if (allTableBody) {
        allTableBody.innerHTML = '';
