    // Filter and populate table
    function filterRosterTable() {
      const query = (document.getElementById('rosterSearchInput').value || '').toLowerCase();
      const statusFilter = document.getElementById('rosterStatusFilter').value;
      const tbody = document.getElementById('rosterTableBody');
      tbody.innerHTML = '';

      const filtered = currentRoster.filter(s => {
        const matchesQuery = s.student_name.toLowerCase().includes(query) || 
                             s.roll_no.toString().includes(query) ||
                             (s.subject && s.subject.toLowerCase().includes(query));
        const matchesStatus = (statusFilter === 'ALL') || (s.status === statusFilter);
        return matchesQuery && matchesStatus;
      });

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="11" class="text-center py-8 text-slate-400">No student records matching filter.</td></tr>`;
        return;
      }

      filtered.forEach(s => {
        let badgeClass = 'bg-slate-100 text-slate-700';
        let standingBadge = 'bg-slate-100 text-slate-700';

        if (s.status === 'Distinction') {
          badgeClass = 'bg-emerald-100 text-emerald-800 font-bold';
          standingBadge = 'bg-emerald-50 text-emerald-700 border border-emerald-200';
        } else if (s.status === 'Good Standing') {
          badgeClass = 'bg-blue-100 text-blue-800 font-bold';
          standingBadge = 'bg-blue-50 text-blue-700 border border-blue-200';
        } else if (s.status === 'Passing') {
          badgeClass = 'bg-amber-100 text-amber-800 font-bold';
          standingBadge = 'bg-amber-50 text-amber-700 border border-amber-200';
        } else if (s.status === 'At Risk') {
          badgeClass = 'bg-rose-100 text-rose-800 font-bold';
          standingBadge = 'bg-rose-50 text-rose-700 border border-rose-200 animate-pulse';
        }

        tbody.innerHTML += `
          <tr class="hover:bg-slate-50/80 transition">
            <td class="px-4 py-3 font-bold text-slate-700">#${s.roll_no}</td>
            <td class="px-4 py-3 font-bold text-slate-900">${s.student_name}</td>
            <td class="px-3 py-3 text-left"><span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-sky-50 text-blue-700 border border-sky-200">${s.subject || 'General'}</span></td>
            <td class="px-3 py-3 text-center text-slate-600">${s.g1}</td>
            <td class="px-3 py-3 text-center text-slate-600">${s.g2}</td>
            <td class="px-3 py-3 text-center text-slate-500">${s.studytime} (${s.studytime >= 3 ? 'High' : 'Normal'})</td>
            <td class="px-3 py-3 text-center ${s.absences > 8 ? 'text-rose-600 font-bold' : 'text-slate-500'}">${s.absences} d</td>
            <td class="px-4 py-3 text-center bg-sky-50/50 text-blue-700 font-black text-sm">${s.predicted_g3} <span class="text-[10px] text-sky-400">/ 20</span></td>
            <td class="px-3 py-3 text-center"><span class="px-2 py-0.5 rounded-full text-xs ${badgeClass}">Grade ${s.letter_grade}</span></td>
            <td class="px-3 py-3 text-center"><span class="px-2 py-0.5 rounded-md text-[11px] font-bold ${standingBadge}">${s.status}</span></td>
            <td class="px-4 py-3 text-[11px] text-slate-600 max-w-xs">${s.recommendation}</td>
          </tr>
        `;
      });
    }

    // Export evaluated table as CSV
