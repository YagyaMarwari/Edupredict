    let currentVivaSubject = 'sml';
    let currentVivaModule = 'mod1';
    let vivaPracticeMode = false;

    function initVivaGuide() {
      renderVivaSubjectGrid();
      selectVivaSubject('sml', false);
    }

    function renderVivaSubjectGrid() {
      const grid = document.getElementById('vivaSubjectGrid');
      if (!grid) return;
      grid.innerHTML = '';

      Object.values(VIVA_DATA).forEach(sub => {
        const isSelected = sub.id === currentVivaSubject;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.onclick = () => selectVivaSubject(sub.id);
        btn.className = `p-3 rounded-xl border text-left transition flex flex-col justify-between ${
          isSelected 
            ? 'bg-blue-600 text-white border-blue-600 shadow-md shadow-blue-500/10 ring-2 ring-sky-400' 
            : 'bg-slate-50 hover:bg-slate-100 text-slate-800 border-slate-200'
        }`;
        btn.innerHTML = `
          <div class="flex items-center justify-between mb-2">
            <i class="fa-solid ${sub.icon} text-lg ${isSelected ? 'text-white' : 'text-blue-600'}"></i>
            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded ${isSelected ? 'bg-white/20 text-white' : 'bg-slate-200 text-slate-600'}">${sub.code}</span>
          </div>
          <span class="text-xs font-bold leading-tight line-clamp-2">${sub.name}</span>
        `;
        grid.appendChild(btn);
      });
    }

    function selectVivaSubject(subId, reRenderQuestions = true) {
      currentVivaSubject = subId;
      const sub = VIVA_DATA[subId];
      if (!sub) return;

      document.getElementById('vivaSelectedSubjectLabel').innerText = `${sub.name} (${sub.code})`;
      renderVivaSubjectGrid();

      // Reset module to mod1 (or first available)
      currentVivaModule = sub.modules[0].id;
      renderVivaModulePills();

      if (reRenderQuestions) {
        renderVivaQuestions();
      }
    }

    function renderVivaModulePills() {
      const container = document.getElementById('vivaModulePills');
      if (!container) return;
      container.innerHTML = '';

      const sub = VIVA_DATA[currentVivaSubject];
      if (!sub) return;

      // Add 'All Modules' option
      const allBtn = document.createElement('button');
      allBtn.type = 'button';
      allBtn.onclick = () => selectVivaModule('all');
      const isAll = currentVivaModule === 'all';
      allBtn.className = `px-3.5 py-1.5 rounded-xl text-xs font-bold transition border ${
        isAll
          ? 'bg-blue-600 text-white border-blue-600 shadow-sm shadow-sky-500/20'
          : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200'
      }`;
      allBtn.innerText = 'All Modules';
      container.appendChild(allBtn);

      sub.modules.forEach(m => {
        const isSelected = m.id === currentVivaModule;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.onclick = () => selectVivaModule(m.id);
        btn.className = `px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center space-x-1.5 border ${
          isSelected 
            ? 'bg-blue-600 text-white border-blue-600 shadow-sm shadow-sky-500/20' 
            : 'bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200'
        }`;
        btn.innerHTML = `
          <span>${m.name}</span>
          <span class="text-[10px] opacity-75 font-normal">(${m.questions.length})</span>
        `;
        container.appendChild(btn);
      });

      updateVivaBanner();
      renderVivaQuestions();
    }

