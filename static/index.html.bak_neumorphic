  async function submitUnifiedLogin() {
    const identifier = document.getElementById('unifiedIdentifier').value.trim();
    const password   = document.getElementById('unifiedPassword').value.trim();
    const btn        = document.getElementById('loginSubmitBtn');
    const errBox     = document.getElementById('loginError');

    errBox.classList.add('hidden');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Signing in...</span>';

    const idLower = identifier.toLowerCase();
    const isTeacher = idLower.includes('teacher') || idLower.includes('faculty') || idLower.includes('prof');

    if (isTeacher) {
      // Role: Teacher / Faculty
      try {
        const res = await fetch('/api/teacher/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: identifier, password })
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok) {
          teacherToken = data.token;
          teacherName  = data.teacher_name || data.name || 'Prof. Sharma';
          localStorage.setItem('edupredict_teacher_token', teacherToken);
          localStorage.setItem('edupredict_teacher_name',  teacherName);
          closeLoginModal();
          applyTeacherSession();
          return;
        } else {
          errBox.textContent = data.detail || 'Incorrect password for Teacher account (use "admin123").';
          errBox.classList.remove('hidden');
          btn.disabled = false;
          btn.innerHTML = '<i class="fa-solid fa-shield-halved"></i><span>Sign In</span>';
          return;
        }
