    async function fetchTeacherUploadedMarks(customRoll) {
      const input = document.getElementById('rosterLookupRoll');
      const statusBox = document.getElementById('rosterLookupStatus');
      const statusMsg = document.getElementById('rosterLookupMsg');
      const query = (customRoll || (input ? input.value : '') || currentPredictorRoll || '101').trim();

      if (!query) {
        if (statusBox) statusBox.classList.remove('hidden');
        if (statusMsg) {
          statusMsg.className = 'text-rose-600';
          statusMsg.innerText = 'Please enter a Student Roll No or select a student.';
        }
        return;
      }

      currentPredictorRoll = query;
      const subjSelect = document.getElementById('predictorSubject');
      const selectedSubject = subjSelect ? subjSelect.value : '';

      try {
        const url = `/api/student/lookup/${encodeURIComponent(query)}` + 
          (selectedSubject ? `?subject=${encodeURIComponent(selectedSubject)}` : '');
        const res = await fetch(url);
        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || 'Student record not found in teacher roster.');
        }
        const student = await res.json();

        // Locked, strictly unadjustable Mid-Term score update
        const midtermVal = parseFloat(student.midterm !== undefined ? student.midterm : (student.g2 !== undefined ? student.g2 : 14.0));
        
        const displayEl = document.getElementById('midterm_score_display');
        if (displayEl) displayEl.innerText = midtermVal.toFixed(1);
        
        const pctBadge = document.getElementById('midterm_percent_badge');
        if (pctBadge) pctBadge.innerText = (midtermVal * 5.0).toFixed(1) + '%';
        
        const barEl = document.getElementById('midterm_bar');
        if (barEl) barEl.style.width = Math.min(100, Math.max(0, midtermVal * 5.0)) + '%';

        // Update hidden inputs for backend regression engine
        document.getElementById('g2').value = midtermVal;
        document.getElementById('g1').value = parseFloat(student.g1 !== undefined ? student.g1 : midtermVal);

        // Update behavioral sliders from teacher's records
        if (student.studytime !== undefined) {
          const st = document.getElementById('studytime');
          if (st) st.value = student.studytime;
          updateStudyTime();
        }
        if (student.absences !== undefined) {
          const abs = document.getElementById('absences');
          if (abs) abs.value = student.absences;
          updateRange('absences', ' days');
        }

        // Update background features from teacher's records
        if (student.failures !== undefined && document.getElementById('failures')) {
          document.getElementById('failures').value = student.failures;
        }
        if (student.medu !== undefined && document.getElementById('medu')) {
          document.getElementById('medu').value = student.medu;
        }
        if (student.fedu !== undefined && document.getElementById('fedu')) {
          document.getElementById('fedu').value = student.fedu;
        }
        if (student.traveltime !== undefined && document.getElementById('traveltime')) {
          document.getElementById('traveltime').value = student.traveltime;
        }
        if (student.internet !== undefined && document.getElementById('internet')) {
          document.getElementById('internet').checked = (student.internet == 1 || student.internet === true || student.internet === 'yes');
        }
        if (student.schoolsup !== undefined && document.getElementById('schoolsup')) {
          document.getElementById('schoolsup').checked = (student.schoolsup == 1 || student.schoolsup === true || student.schoolsup === 'yes');
        }
        if (student.famsup !== undefined && document.getElementById('famsup')) {
          document.getElementById('famsup').checked = (student.famsup == 1 || student.famsup === true || student.famsup === 'yes');
        }
        if (student.higher !== undefined && document.getElementById('higher')) {
          document.getElementById('higher').checked = (student.higher == 1 || student.higher === true || student.higher === 'yes');
        }

        // Sync dropdown & roll input
        const sel = document.getElementById('rosterStudentSelect');
        if (sel) sel.value = student.roll_no;
        if (input) input.value = student.roll_no;

        if (statusBox) statusBox.classList.remove('hidden');
        if (statusMsg) {
          statusMsg.className = 'text-emerald-700';
          statusMsg.innerHTML = `<i class="fa-solid fa-lock text-amber-500 mr-1.5"></i> Loaded official records for <strong>${student.student_name || query}</strong> (Roll: ${student.roll_no}) — Mid-Sem: <strong>${midtermVal.toFixed(1)} / 20</strong> (Locked)`;
        }

        triggerPrediction();
      } catch (err) {
        if (statusBox) statusBox.classList.remove('hidden');
        if (statusMsg) {
          statusMsg.className = 'text-rose-600';
          statusMsg.innerHTML = `<i class="fa-solid fa-circle-exclamation mr-1"></i> ${err.message || 'Student not found in uploaded roster.'}`;
        }
      }
    }

