      currentRoster.forEach(s => {
        if (gradeCounts[s.letter_grade] !== undefined) {
          gradeCounts[s.letter_grade]++;
        }
      });

      const ctx = document.getElementById('classGradeChart').getContext('2d');
      if (classChartInstance) classChartInstance.destroy();

      classChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Grade A (≥ 15)', 'Grade B (12-14)', 'Grade C (10-11)', 'Grade F (< 10 At Risk)'],
          datasets: [{
            data: [gradeCounts['A'], gradeCounts['B'], gradeCounts['C'], gradeCounts['F']],
            backgroundColor: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444'],
            borderRadius: 6
